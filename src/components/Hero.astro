---
import { HERO } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);
---

<section class="hero-glow relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-20 text-center sm:pt-24 sm:pb-28">
    <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-background)]/80 px-3 py-1 text-xs font-medium text-[var(--color-muted-foreground)] backdrop-blur">
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
      {HERO.eyebrow[lang]}
    </span>

    <h1 class="mx-auto mt-6 max-w-4xl text-balance text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl md:text-6xl">
      {HERO.title[lang]}
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-pretty text-base leading-relaxed text-[var(--color-muted-foreground)] sm:text-lg">
      {HERO.subtitle[lang]}
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="#cta"
        class="inline-flex h-11 items-center justify-center rounded-[var(--radius)] bg-[var(--color-primary)] px-6 text-sm font-medium text-[var(--color-primary-foreground)] shadow-sm transition hover:opacity-90"
      >
        {HERO.primaryCta[lang]}
      </a>
      <a
        href="#how"
        class="inline-flex h-11 items-center justify-center rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-background)]/60 px-6 text-sm font-medium text-[var(--color-foreground)] transition hover:bg-[var(--color-muted)]"
      >
        {HERO.secondaryCta[lang]} →
      </a>
    </div>

    <p class="mt-6 text-xs text-[var(--color-muted-foreground)]">{HERO.trustline[lang]}</p>

    <!-- Product mock-up — Live monitoring screenshot with risk boxes -->
    <div class="mx-auto mt-14 max-w-5xl">
      <div class="overflow-hidden rounded-[calc(var(--radius)*1.5)] border border-[var(--color-border)] bg-[oklch(0.18_0.02_250)] shadow-2xl">
        <!-- Browser chrome -->
        <div class="flex items-center gap-1.5 border-b border-black/30 bg-[oklch(0.14_0.02_250)] px-3 py-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.55_0.22_25)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.78_0.16_85)]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.65_0.18_145)]"></span>
          <span class="ml-3 truncate rounded-md bg-black/30 px-3 py-0.5 text-xs text-white/60">app.sentry.chipmo.mn / live</span>
        </div>
        <!-- 4-camera grid mock -->
        <div class="grid grid-cols-2 gap-1 bg-black p-1">
          {[
            { label: "Касс 1 · Хикvision", boxes: [{ x: 18, y: 32, w: 22, h: 50, risk: 18, c: "green" }, { x: 56, y: 28, w: 18, h: 54, risk: 42, c: "yellow" }] },
            { label: "Тавиур 2 · UNV",     boxes: [{ x: 30, y: 20, w: 28, h: 64, risk: 82, c: "red" }] },
            { label: "Гарц · Tapo",          boxes: [{ x: 40, y: 28, w: 22, h: 56, risk: 9, c: "green" }] },
            { label: "Тавиур 4 · Hikvision", boxes: [{ x: 14, y: 26, w: 20, h: 58, risk: 28, c: "green" }, { x: 60, y: 30, w: 22, h: 54, risk: 65, c: "yellow" }] },
          ].map((cam) => (
            <div class="relative aspect-video overflow-hidden bg-gradient-to-br from-[oklch(0.22_0.02_250)] to-[oklch(0.16_0.02_250)]">
              <!-- Faux scene gradient -->
              <div class="absolute inset-0 opacity-50" style="background: radial-gradient(circle at 30% 70%, oklch(0.4 0.05 240), transparent 60%)"></div>
              <!-- Boxes -->
              {cam.boxes.map((b) => {
                const ringColor = b.c === "red" ? "var(--color-level-review)" : b.c === "yellow" ? "var(--color-level-notify)" : "var(--color-success)";
                return (
                  <div
                    class="absolute border-2 backdrop-blur-[1px]"
                    style={`left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%;border-color:${ringColor};box-shadow:0 0 0 1px rgba(0,0,0,0.35);`}
                  >
                    <span
                      class="absolute -top-5 left-0 rounded px-1.5 py-0.5 text-[10px] font-semibold text-white"
                      style={`background:${ringColor}`}
                    >
                      {b.risk}%
                    </span>
                  </div>
                );
              })}
              <!-- Camera label -->
              <div class="absolute bottom-1.5 left-1.5 rounded bg-black/65 px-1.5 py-0.5 text-[10px] font-medium text-white/90">
                {cam.label}
              </div>
              <!-- Live dot -->
              <div class="absolute top-1.5 right-1.5 flex items-center gap-1 rounded bg-black/65 px-1.5 py-0.5 text-[10px] text-white/90">
                <span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-pulse"></span>
                LIVE
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
