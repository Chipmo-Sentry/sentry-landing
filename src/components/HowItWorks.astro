---
import { HOW } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);
---

<section id="how" class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{HOW.title[lang]}</h2>
      <p class="mt-3 text-[var(--color-muted-foreground)]">{HOW.subtitle[lang]}</p>
    </div>

    <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {HOW.steps.map((step, i) => (
        <li class="lift relative rounded-[calc(var(--radius)*1.5)] border border-[var(--color-border)] bg-[var(--color-background)] p-6">
          <span class="font-mono text-xs font-semibold tracking-widest text-[var(--color-primary)]">{step.n}</span>
          <h3 class="mt-4 text-lg font-semibold">{step.title[lang]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted-foreground)]" set:html={step.body[lang].replace(/\*\*(.*?)\*\*/g, '<strong class="text-[var(--color-foreground)]">$1</strong>')}></p>

          {i < HOW.steps.length - 1 && (
            <!-- Arrow connector (hidden on mobile) -->
            <svg
              class="absolute top-1/2 -right-3 hidden h-6 w-6 -translate-y-1/2 text-[var(--color-border)] lg:block"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
