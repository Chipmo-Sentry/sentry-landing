---
import { RISKS } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);

const ICONS: Record<string, string> = {
  theft: `<path d="M3 7h18l-1.5 13H4.5z"/><path d="M8 7V5a4 4 0 018 0v2"/>`,
  suspicious: `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>`,
  internal: `<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/>`,
  zone: `<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8l8 8M16 8l-8 8"/>`,
  ppe: `<path d="M12 3l8 3v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>`,
  safety: `<path d="M12 2l9 5v6c0 5-3.8 8.5-9 9-5.2-.5-9-4-9-9V7z"/><path d="M12 9v3M12 15h.01"/>`,
};
---

<section id="risks" class="border-t border-[var(--color-border)] bg-[var(--color-background)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{RISKS.title[lang]}</h2>
      <p class="mt-3 text-[var(--color-muted-foreground)]">{RISKS.subtitle[lang]}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {RISKS.cards.map((c) => (
        <article class="lift rounded-[calc(var(--radius)*1.5)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-[var(--radius)] bg-[var(--color-primary-tint)] text-[var(--color-primary)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon] ?? ICONS.safety}></svg>
          </div>
          <h3 class="mt-4 text-base font-semibold">{c.title[lang]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted-foreground)]">{c.body[lang]}</p>
        </article>
      ))}
    </div>
  </div>
</section>
