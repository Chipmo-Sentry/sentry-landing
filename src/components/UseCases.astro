---
import { USE_CASES } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);

const ICONS: Record<string, string> = {
  checkout: `<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>`,
  aisles: `<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9h18M3 14h18M8 4v16M16 4v16"/>`,
  entrance: `<path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/><path d="M10 17l5-5-5-5M15 12H3"/>`,
  stockroom: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>`,
};
---

<section id="use-cases" class="border-t border-[var(--color-border)] bg-[var(--color-background)]">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{USE_CASES.title[lang]}</h2>
      <p class="mt-3 text-[var(--color-muted-foreground)]">{USE_CASES.subtitle[lang]}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {USE_CASES.cards.map((c) => (
        <article class="lift flex flex-col rounded-[calc(var(--radius)*1.5)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-[var(--radius)] bg-[var(--color-primary-tint)] text-[var(--color-primary)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon] ?? ICONS.checkout}></svg>
          </div>
          <h3 class="mt-4 font-semibold">{c.title[lang]}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-muted-foreground)]">{c.body[lang]}</p>
        </article>
      ))}
    </div>
  </div>
</section>
