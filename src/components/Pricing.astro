---
import { PRICING } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);
---

<section id="pricing" class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{PRICING.title[lang]}</h2>
      <p class="mt-3 text-[var(--color-muted-foreground)]">{PRICING.subtitle[lang]}</p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {PRICING.tiers.map((t) => (
        <article
          class={`relative flex flex-col rounded-[calc(var(--radius)*1.5)] border bg-[var(--color-background)] p-6 ${t.highlight ? "border-[var(--color-primary)] ring-1 ring-[var(--color-primary)] shadow-md" : "border-[var(--color-border)]"}`}
        >
          {t.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[var(--color-primary)] px-3 py-0.5 text-xs font-semibold text-[var(--color-primary-foreground)]">
              {lang === "mn" ? "Хамгийн алдартай" : "Most popular"}
            </span>
          )}

          <header>
            <h3 class="text-lg font-semibold">{t.name[lang]}</h3>
            <p class="mt-1 text-sm text-[var(--color-muted-foreground)]">{t.tagline[lang]}</p>
          </header>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight">{t.price[lang]}</span>
              <span class="text-sm text-[var(--color-muted-foreground)]">{t.period[lang]}</span>
            </div>
          </div>

          <a
            href="#cta"
            class={`mt-6 inline-flex h-10 items-center justify-center rounded-[var(--radius)] px-4 text-sm font-medium transition ${t.highlight ? "bg-[var(--color-primary)] text-[var(--color-primary-foreground)] shadow-sm hover:opacity-90" : "border border-[var(--color-border)] hover:bg-[var(--color-muted)]"}`}
          >
            {t.cta[lang]}
          </a>

          <ul class="mt-6 space-y-2.5">
            {t.features.map((f) => (
              <li class="flex items-start gap-2 text-sm">
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--color-success)]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.2 7.2a1 1 0 01-1.4 0L4.3 10a1 1 0 011.4-1.4l3.1 3.1 6.5-6.5a1 1 0 011.4 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-[var(--color-foreground)]">{f[lang]}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-[var(--color-muted-foreground)]">
      {PRICING.note[lang]}
    </p>
  </div>
</section>
