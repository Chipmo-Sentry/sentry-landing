---
import { PRICING } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);
---

<section id="pricing" class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{PRICING.title[lang]}</h2>
      <p class="mt-4 text-lg text-[var(--color-muted-foreground)]">{PRICING.subtitle[lang]}</p>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl items-stretch gap-6 md:grid-cols-3">
      {PRICING.tiers.map((t) => {
        const isEnterprise = t.id === "enterprise";
        const isPro = t.highlight;
        return (
          <article
            class={[
              "relative flex flex-col rounded-2xl p-8 transition",
              isEnterprise
                ? "bg-[var(--color-navy)] text-white shadow-2xl ring-1 ring-white/10"
                : isPro
                ? "bg-[var(--color-background)] border-2 border-[var(--color-primary)] shadow-lg md:-my-2 md:py-10"
                : "bg-[var(--color-background)] border border-[var(--color-border)] shadow-sm",
            ].join(" ")}
          >
            {isPro && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-[var(--color-primary)] px-4 py-1 text-xs font-semibold text-[var(--color-primary-foreground)] shadow-sm">
                {lang === "mn" ? "Хамгийн алдартай" : "Most popular"}
              </span>
            )}

            <header>
              <h3 class={`text-lg font-semibold ${isEnterprise ? "text-white" : "text-[var(--color-foreground)]"}`}>{t.name[lang]}</h3>
              <p class={`mt-1.5 text-sm ${isEnterprise ? "text-white/60" : "text-[var(--color-muted-foreground)]"}`}>{t.tagline[lang]}</p>
            </header>

            <div class="mt-6 flex items-baseline gap-1.5">
              <span class={`text-4xl font-bold tracking-tight ${isEnterprise ? "text-white" : "text-[var(--color-foreground)]"}`}>{t.price[lang]}</span>
              {t.period[lang] && (
                <span class={`text-sm ${isEnterprise ? "text-white/50" : "text-[var(--color-muted-foreground)]"}`}>{t.period[lang]}</span>
              )}
            </div>

            <a
              href="#cta"
              class={[
                "mt-7 inline-flex h-12 items-center justify-center rounded-[var(--radius)] px-5 text-sm font-semibold transition",
                isEnterprise
                  ? "bg-[var(--color-primary)] text-[var(--color-primary-foreground)] shadow-sm hover:bg-[var(--color-primary-strong)]"
                  : isPro
                  ? "bg-[var(--color-primary)] text-[var(--color-primary-foreground)] shadow-sm hover:bg-[var(--color-primary-strong)]"
                  : "border border-[var(--color-border)] text-[var(--color-foreground)] hover:border-[var(--color-primary)] hover:bg-[var(--color-surface)]",
              ].join(" ")}
            >
              {t.cta[lang]}
            </a>

            <ul class="mt-8 space-y-3">
              {t.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <svg
                    class={`mt-0.5 h-5 w-5 flex-shrink-0 ${isEnterprise ? "text-[var(--color-primary)]" : "text-[var(--color-primary)]"}`}
                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5"/>
                  </svg>
                  <span class={isEnterprise ? "text-white/85" : "text-[var(--color-foreground)]"}>{f[lang]}</span>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-[var(--color-muted-foreground)]">
      {PRICING.note[lang]}
    </p>
  </div>
</section>
