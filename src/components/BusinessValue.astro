---
import { VALUE } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);

const ICONS: Record<string, string> = {
  loss: `<path d="M3 17l6-6 4 4 7-7"/><path d="M21 8v5h-5"/>`,
  workload: `<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>`,
  leverage: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>`,
  report: `<path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9z"/><path d="M14 3v6h6M9 14l2 2 4-4"/>`,
};
---

<section id="value" class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{VALUE.title[lang]}</h2>
      <p class="mt-3 text-[var(--color-muted-foreground)]">{VALUE.subtitle[lang]}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {VALUE.cards.map((c) => (
        <article class="lift flex gap-4 rounded-[calc(var(--radius)*1.5)] border border-[var(--color-border)] bg-[var(--color-background)] p-6">
          <div class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-[var(--radius)] bg-[var(--color-primary-tint)] text-[var(--color-primary)]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon] ?? ICONS.loss}></svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold">{c.title[lang]}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-muted-foreground)]">{c.body[lang]}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
