---
import { FEATURES } from "@/lib/content";
import { type Lang, pickLang } from "@/lib/i18n";

interface Props { lang?: Lang }
const lang = pickLang(Astro.props.lang);

// kind → grid placement class
const placement: Record<string, string> = {
  large:  "md:col-span-2 md:row-span-2",
  medium: "md:col-span-2",
  small:  "",
};

const ICONS: Record<string, string> = {
  live: `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>`,
  shield: `<path d="M12 2l9 4v6c0 5-3.8 9.4-9 10-5.2-.6-9-5-9-10V6l9-4z"/>`,
  telegram: `<path d="M21 4L2 12l5 2 9-7-6 9 8 4z"/>`,
  save: `<path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>`,
  privacy: `<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>`,
  language: `<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/>`,
  feedback: `<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"/><path d="M9 10h.01M13 10h.01M17 10h.01"/>`,
  lightning: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
};
---

<section id="features" class="border-t border-[var(--color-border)] bg-[var(--color-background)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{FEATURES.title[lang]}</h2>
      <p class="mt-3 text-[var(--color-muted-foreground)]">{FEATURES.subtitle[lang]}</p>
    </div>

    <div class="mt-14 grid auto-rows-fr gap-4 md:grid-cols-4">
      {FEATURES.cards.map((c) => (
        <article class={`lift rounded-[calc(var(--radius)*1.5)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 ${placement[c.kind] ?? ""}`}>
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-[var(--radius)] bg-[var(--color-primary-tint)] text-[var(--color-primary)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[c.icon] ?? ICONS.shield}></svg>
          </div>
          <h3 class={`mt-4 font-semibold ${c.kind === "large" ? "text-xl" : "text-base"}`}>{c.title[lang]}</h3>
          <p class={`mt-2 text-[var(--color-muted-foreground)] leading-relaxed ${c.kind === "large" ? "text-base" : "text-sm"}`}>
            {c.body[lang]}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
