---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { pickLang } from "@/lib/i18n";

const lang = pickLang(Astro.url.searchParams.get("lang"));
const TITLE = lang === "mn" ? "Талархлаа" : "Thank you";
---

<Layout title={`${TITLE} — Chipmo Sentry`} description={TITLE} lang={lang} noindex>
  <Header lang={lang} />

  <main class="mx-auto max-w-2xl px-4 py-24 text-center">
    <div class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-success)]/15 text-[var(--color-success)]">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>

    <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{TITLE}!</h1>
    <p class="mt-4 text-[var(--color-muted-foreground)]">
      {lang === "mn"
        ? "Хүсэлтийг хүлээж авлаа. 24 цагийн дотор тантай холбоо барина. Асуулт байвал шууд hello@chipmo.mn руу бичээрэй."
        : "We've received your request. We'll reach out within 24 hours. Meanwhile, feel free to email hello@chipmo.mn with any questions."}
    </p>

    <a
      href="/"
      class="mt-10 inline-flex h-10 items-center justify-center rounded-[var(--radius)] border border-[var(--color-border)] px-5 text-sm font-medium hover:bg-[var(--color-muted)]"
    >
      ← {lang === "mn" ? "Нүүр хуудас" : "Back to home"}
    </a>
  </main>

  <Footer lang={lang} />
</Layout>
